---
import { twMerge } from "tailwind-merge";
interface Props {
  class?: string;
  tag?: string;
  href?: string;
  target?: string;
}

const {
  class: className,
  tag = "button",
  href,
  target = "_blank",
  ...props
} = Astro.props;
---

{
  tag === "a" ? (
    <a
      href={href}
      class:list={twMerge(
        "text-base transition sm:text-lg px-3 sm:px-5 py-2 sm:py-2",
        className,
      )}
      target={target}
      {...props}
    >
      <slot />
    </a>
  ) : (
    <button
      class:list={twMerge(
        "text-base cursor-pointer transition sm:text-lg px-3 sm:px-5 py-2 sm:py-2",
        className,
      )}
      {...props}
    >
      <slot />
    </button>
  )
}
