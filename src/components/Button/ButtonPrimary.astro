---
import Button from "./Button.astro";
import { twMerge } from "tailwind-merge";

interface Props {
  class?: string;
  tag?: string;
  href?: string;
  target?: string;
}

const {
  class: className,
  tag = "button",
  href,
  target = "_blank",
} = Astro.props;
---

<Button
  class:list={twMerge(
    "bg-primary text-white transition hover:bg-primary-500 font-semibold rounded-lg flex justify-center items-center space-x-2.5 shadow-md hover:shadow-lg",
    className,
  )}
  tag={tag}
  href={tag === "a" ? href : undefined}
  target={tag === "a" ? target : undefined}
>
  <slot />
</Button>
