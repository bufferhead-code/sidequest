---
const { title } = Astro.props;
import { Icon } from "astro-icon/components";
---

<div class="flex space-x-2">
  <div class="pt-0.5">
    <Icon name="ph:caret-right-bold" class="w-5 h-5 text-primary-600" />
  </div>
  <div>
    <h3 class="font-semibold">{title}</h3>
    <p class="py-0.5 sm:py-1 max-w-md text-sm sm:text-base"><slot /></p>
  </div>
</div>
