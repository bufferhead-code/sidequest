---
import FeatureListItem from "./FeatureListItem.astro";
---

<div class="container mx-auto px-4 max-w-6xl pt-10 isolate">
  <h3 class="mx-auto text-2xl sm:text-5xl pt-12 font-display text-center">
    Advanced Libraries and APIs
  </h3>
  <p
    class="max-w-xl text-center mx-auto text-base sm:text-lg pt-4 text-gray-500 font-semibold"
  >
    Sidequest provides you with a set of tools to work with any idea you have in
    mind and make it a reality.
  </p>

  <div class="grid sm:grid-cols-2 gap-6 py-8 sm:py-16">
    <FeatureListItem title="Sidequest Auth">
      A robust authentication library for managing user logins, registrations,
      and secure sessions.
    </FeatureListItem>
    <FeatureListItem title="Sidequest Data">
      A powerful data manipulation library for handling complex data
      transformations and queries.
    </FeatureListItem>
    <FeatureListItem title="Sidequest UI">
      A comprehensive UI component library for building responsive and
      accessible user interfaces.
    </FeatureListItem>
    <FeatureListItem title="Sidequest Analytics">
      An advanced analytics library for tracking user interactions and
      generating insightful reports.
    </FeatureListItem>
    <FeatureListItem title="Sidequest Payments">
      A secure payment processing library for integrating various payment
      gateways and handling transactions.
    </FeatureListItem>
    <FeatureListItem title="Sidequest Notifications">
      A versatile notification library for sending real-time alerts and messages
      to users.
    </FeatureListItem>
    <FeatureListItem title="Sidequest Media">
      A media handling library for processing and streaming audio, video, and
      images efficiently.
    </FeatureListItem>
    <FeatureListItem title="Sidequest Storage">
      A scalable storage library for managing files, documents, and media assets
      in the cloud.
    </FeatureListItem>
  </div>
</div>
