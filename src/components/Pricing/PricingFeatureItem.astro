---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="flex items-center space-x-4 font-medium">
  <Icon name="ph:check-circle-bold" class="text-primary-600 w-6 h-6" />
  <span class="flex-1">
    {title}
  </span>
</div>
