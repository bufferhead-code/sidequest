---
import logo from "../../images/logo.svg";
import headerTerminal from "../../images/header-terminal.svg";
import { Image } from "astro:assets";
import ButtonSecondary from "../../components/Button/ButtonSecondary.astro";
import ButtonPrimary from "../../components/Button/ButtonPrimary.astro";
---

<div class="sm:grid grid-cols-2 gap-x-6 relative">
  <div
    class="absolute w-full h-full top-0 left-0 bg-white/50 backdrop-blur-[3px] rounded-lg"
    style="box-shadow: 0px 0px 30px 40px rgba(255,255,255,1);"
  >
  </div>

  <div class="relative">
    <div class="isolate">
      <div class="flex items-center gap-3">
        <Image
          src={logo}
          alt="Sidequest Logo"
          class="h-8 sm:h-10 w-auto ml-4"
        />
        <span class="text-3xl font-bold text-gray-800">SIDEQUEST</span>
      </div>
      <div class="px-3">
        <h1
          class="text-3xl sm:text-5xl max-w-lg font-display pt-7 sm:pb-3 pb-2 leading-[110%]"
        >
          The Ultimate Tool for achieving anything
        </h1>
        <p class="text-base sm:text-xl font-medium max-w-md text-gray-600">
          Sidequest is the ultimate all-in-one tool to create files, documents
          and projects.
        </p>
        <div class="pt-6 flex flex-col lg:flex-row sm:space-x-6 space-y-3 sm:space-y-0">
          <ButtonPrimary>Install now</ButtonPrimary>
          <ButtonSecondary href="#">Learn More</ButtonSecondary>
        </div>
      </div>
    </div>
  </div>
  <div class="flex items-center">
    <div class="bg-white isolate mt-8">
      <div class="relative px-3">
        <Image src={headerTerminal} alt="Terminal" class="w-full" />
      </div>
    </div>
  </div>
</div>
