---
import OpenSourceBackground from "../../images/open-source-background.svg";
import OpenSourceIcon from "../../images/open-source-icon.svg";
import CrossPlatformBackground from "../../images/cross-platform-background.svg";
import CrossPlatformIcon from "../../images/cross-platform-icon.svg";
import FastBackground from "../../images/fast-bg.svg";
import FastIcon from "../../images/fast-icon.svg";
import BattleTestedIcon from "../../images/battle-tested-icon.svg";
---

<div
  class="sm:grid sm:grid-cols-[0.8fr_1fr_1fr] sm:grid-rows-2 gap-5 mt-16 relative z-20 space-y-4 sm:space-y-0"
>
  <div
    class="sm:row-span-2 border bg-white relative border-gray-200 pb-3 rounded-xl shadow"
  >
    <OpenSourceBackground
      class="w-full h-[300px] left-0 top-0 absolute bg-no-repeat"
    />
    <div class="px-5 py-6 text-center isolate">
      <OpenSourceIcon class="mx-auto isolate text-primary-500" />
      <h3 class="py-3 uppercase font-bold font-display text-2xl">
        Open Source
      </h3>
      <p
        class="max-w-[300px] mx-auto font-medium text-gray-700 text-sm sm:text-base"
      >
        The core of Sidequest is open-source software which allows for a wide
        variety of use cases and incorporation in other software products.
      </p>
      <p
        class="pt-2 sm:pt-4 max-w-[300px] mx-auto text-sm sm:text-base font-medium text-gray-700"
      >
        Feel free to contribute.
      </p>
    </div>
  </div>
  <div class="sm:col-start-2 relative isolate">
    <div
      class="px-5 py-3 overflow-hidden h-full items-center border bg-white relative border-gray-200 pb-3 rounded-xl shadow flex justify-between"
    >
      <CrossPlatformBackground
        class="w-full h-full right-0 top-0 absolute bg-no-repeat"
        style="background-position: center right;"
      />
      <div class="isolate">
        <h3 class="pt-3 pb-2 uppercase font-bold font-display text-xl">
          Cross Platform
        </h3>
        <p class="max-w-[190px] font-medium text-gray-700">
          Sidequest is designed to run cross-platform on all sorts of popular
          operating systems.
        </p>
      </div>
      <CrossPlatformIcon class="isolate" />
    </div>
  </div>
  <div class="col-start-3 relative isolate">
    <div
      class="px-5 py-3 h-full items-center border bg-white relative border-gray-200 pb-3 rounded-xl shadow flex overflow-hidden justify-between"
    >
      <FastBackground
        class="min-w-full min-h-full right-0 top-0 absolute bg-no-repeat"
      />
      <div class="isolate">
        <h3 class="pt-3 pb-2 uppercase font-bold font-display text-xl">
          Super Fast
        </h3>
        <p class="max-w-[280px] mx-auto font-medium text-gray-700">
          Sidequest strives to always push the limits on performance and speed
          of its software.
        </p>
      </div>
      <FastIcon class="isolate" />
    </div>
  </div>
  <div class="col-span-2">
    <div
      class="px-5 py-3 overflow-hidden h-full items-center border bg-white relative border-gray-200 pb-3 rounded-xl space-y-5 sm:space-y-0 shadow sm:flex justify-between"
    >
      <CrossPlatformBackground
        class="max-w-full h-full right-0 top-0 absolute bg-no-repeat"
      />
      <div class="max-w-lg isolate">
        <h3 class="pt-3 pb-2 uppercase font-bold font-display text-xl">
          Battle-Tested
        </h3>
        <p class="mx-auto font-medium text-gray-700">
          Sidekick powers software all over the world and powers some of the
          biggest companies of the world under the hood. It is used, tested and
          loved by thousands of developers for its reliability and performance.
        </p>
      </div>
      <BattleTestedIcon class="isolate" />
    </div>
  </div>
</div>
