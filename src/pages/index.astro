---
import Layout from "../layouts/Layout.astro";
import headerBg from "../images/header-bg.svg";
import FeatureSection from "../components/Feature/FeatureSection.astro";
import BentoGrid from "./Partials/BentoGrid.astro";
import Testimonials from "./Partials/Testimonials.astro";
import Hero from "./Partials/Hero.astro";
import PricingSection from "../components/Pricing/PricingSection.astro";
import Footer from "../components/Footer.astro";
import FeatureImageSection from "../components/Feature/FeatureImageSection.astro";
import FeatureListSection from "../components/Feature/FeatureListSection.astro";
---

<Layout title="Sidequest - The Ultimate Tool to achieve anything">
  <div class="bg-gradient-to-r from-primary-400 to-primary-800 w-full h-3">
  </div>
  <main>
    <div class="relative" style={`background-image: url(${headerBg.src});`}>
      <div
        class="absolute left-0 bottom-0 bg-gradient-to-t w-full from-white via-white to-transparent h-[400px]"
      >
      </div>
      <div class="container mx-auto px-4 pt-12 sm:pt-24 max-w-6xl">
        <Hero />
        <Testimonials />
        <BentoGrid />
      </div>
    </div>
    <FeatureSection />
    <FeatureImageSection />
    <PricingSection />
    <FeatureListSection />
    <Footer />
  </main>
</Layout>

<style is:global>
  [x-cloak] {
    display: none !important;
  }
</style>
